{
  "target": "plugins/crew-orchestrator/lib/landing.sh",
  "suite": [
    "bats",
    "--abort",
    "tests/landing-lib.bats",
    "tests/land-batch.bats"
  ],
  "mutants": [
    {
      "name": "ignored checks aren't passed",
      "old": "    --ignored \"$IGNORED\" --min-green",
      "new": "    --ignored \"\" --min-green"
    },
    {
      "name": "ignored_checks may name the required check",
      "old": "    [[ $v != \"$CHECK\" ]] || { echo \"$TOOL: ignored_checks names",
      "new": "    true || { echo \"$TOOL: ignored_checks names"
    },
    {
      "name": "ignored_checks names aren't trimmed",
      "old": "    v=${v#\"${v%%[![:space:]]*}\"}; v=${v%\"${v##*[![:space:]]}\"}\n",
      "new": ""
    },
    {
      "name": "an App author isn't mapped to its [bot] login",
      "old": "    [[ $author != app/* ]] || author=\"${author#app/}[bot]\"\n",
      "new": ""
    }
  ]
}
