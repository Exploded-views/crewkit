{
  "target": "plugins/crew-orchestrator/bin/land-batch",
  "suite": [
    "bats",
    "--abort",
    "tests/landing-lib.bats",
    "tests/land-batch.bats"
  ],
  "mutants": [
    {
      "name": "squash not pinned to the verified head",
      "old": "--squash --match-head-commit \"${HEAD[$pr]}\"",
      "new": "--squash"
    },
    {
      "name": "parent check skipped",
      "old": "    [[ $(git -C \"$WT\" rev-parse \"$mc^\" 2>/dev/null) == \"$prev\" ]] ||",
      "new": "    true ||"
    },
    {
      "name": "tree check skipped",
      "old": "    [[ $(git -C \"$WT\" rev-parse \"$mc^{tree}\") == \"${TREE[$pr]}\" ]] ||",
      "new": "    true ||"
    },
    {
      "name": "main not re-checked before each squash",
      "old": "      main_is \"$prev\" || stop_merge 7",
      "new": "      true || stop_merge 7"
    },
    {
      "name": "no recheck before merging",
      "old": "    if [[ -n $PROB || $PR_HEAD != \"${HEAD[$pr]}\" ]]; then",
      "new": "    if false; then"
    },
    {
      "name": "up-to-date refusal retried as a generic failure",
      "old": "        stop_merge 10 \"#$pr REFUSED",
      "new": "        stop_merge 8 \"#$pr REFUSED"
    },
    {
      "name": "partial landing not reported",
      "old": "  if ((${#LANDED[@]})); then loud_partial \"$why\" \"$*\"; else",
      "new": "  if false; then loud_partial \"$why\" \"$*\"; else"
    },
    {
      "name": "a normal exit 20 reported as a partial landing",
      "old": "FINISHED=1\n",
      "new": "true\n"
    },
    {
      "name": "an unchecked fetch after a squash",
      "old": "    git -C \"$WT\" fetch -q origin \"$MAIN\" ||\n      stop_merge 12 \"cannot fetch",
      "new": "    git -C \"$WT\" fetch -q origin \"$MAIN\" ||\n      true || stop_merge 12 \"cannot fetch"
    },
    {
      "name": "PR heads aren't re-checked before the squash",
      "old": "    [[ $c == success ]] || stop_merge 9 \"#$pr: CI on its head is no longer green",
      "new": "    true || stop_merge 9 \"#$pr: CI on its head is no longer green"
    }
  ]
}
