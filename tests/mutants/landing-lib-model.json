{
  "target": "plugins/crew-orchestrator/lib/landing.sh",
  "suite": [
    "bats",
    "--abort",
    "tests/landing-lib.bats",
    "tests/land-batch.bats"
  ],
  "mutants": [
    {
      "name": "comment verdicts skip review_model",
      "old": "--require-sha \"$REQUIRE_SHA\" --model \"$REVIEW_MODEL\" 2>&1)",
      "new": "--require-sha \"$REQUIRE_SHA\" --model \"\" 2>&1)"
    },
    {
      "name": "record verdicts skip review_model",
      "old": "--reviewers \"$REVIEWERS\" --model \"$REVIEW_MODEL\")",
      "new": "--reviewers \"$REVIEWERS\" --model \"\")"
    },
    {
      "name": "review_model defaults to no model",
      "old": "  REVIEW_MODEL=$(crew_setting review_model opus)",
      "new": "  REVIEW_MODEL=$(crew_setting review_model \"\")"
    },
    {
      "name": "an empty review_model is ignored",
      "old": "  REVIEW_MODEL=$(crew_setting review_model opus)",
      "new": "  REVIEW_MODEL=opus"
    },
    {
      "name": "an unnamed author is accepted",
      "old": "    [[ -n $author ]] || { VWHY=\"the PR's author can't be named\"; return 1; }",
      "new": "    true"
    },
    {
      "name": "settings read from wherever the lander started",
      "old": "  crew_cd_main_checkout || crew_land_config_error \"$TOOL: can't find",
      "new": "  true || crew_land_config_error \"$TOOL: can't find"
    }
  ]
}
