{
  "target": "tools/secrets-scan.sh",
  "suite": [
    "bats",
    "--abort",
    "tests/secrets-scan.bats"
  ],
  "mutants": [
    {
      "name": "no gitleaks reads as clean",
      "old": "[[ -x $g ]] || fail",
      "new": "[[ -x $g ]] || true"
    },
    {
      "name": "no recorded sha256 accepted",
      "old": "[[ -r $g.sha256 ]] || fail",
      "new": "[[ -r $g.sha256 ]] || true"
    },
    {
      "name": "a changed gitleaks accepted",
      "old": "[[ $(sha256 \"$g\") == \"$(head -c 64 \"$g.sha256\")\" ]] || fail",
      "new": "true || fail"
    },
    {
      "name": "a shallow clone accepted",
      "old": "[[ $(git rev-parse --is-shallow-repository 2>/dev/null) == false ]] ||",
      "new": "true ||"
    },
    {
      "name": "only the current branch scanned",
      "old": "--log-opts=\"--all ",
      "new": "--log-opts=\""
    },
    {
      "name": "a gitleaks error reads as clean",
      "old": "  *) fail \"gitleaks failed (exit $rc); the scan did not complete\" ;;",
      "new": "  *) echo \"secrets: clean\" ;;"
    },
    {
      "name": "leaks pass",
      "old": "  1) fail \"gitleaks found leaks",
      "new": "  1) echo \"gitleaks found leaks"
    },
    {
      "name": "the tree's gitleaks config used",
      "old": "--config \"$cfg/gitleaks.toml\" ",
      "new": ""
    },
    {
      "name": "the tree's .gitleaksignore used",
      "old": " --gitleaks-ignore-path \"$cfg/gitleaksignore\"",
      "new": ""
    },
    {
      "name": "gitleaks:allow comments honored",
      "old": "  --ignore-gitleaks-allow --log-opts",
      "new": "  --log-opts"
    },
    {
      "name": "a tree with a gitleaks config accepted",
      "old": "[[ -z $in_tree ]] ||",
      "new": "true ||"
    },
    {
      "name": "an untracked config at the top accepted",
      "old": "for f in .gitleaks.toml .gitleaksignore; do [[ ! -e $f ]] || echo \"$f\"; done;",
      "new": ":;"
    },
    {
      "name": "an allowlist in the script's config",
      "old": "'[extend]' 'useDefault = true'",
      "new": "'[extend]' 'useDefault = true' '[allowlist]' 'paths = [\".*\"]'"
    },
    {
      "name": "a binary attribute hides a change",
      "old": "--all -m --text --no-textconv",
      "new": "--all -m --no-textconv"
    },
    {
      "name": "a textconv driver hides a change",
      "old": "--text --no-textconv --no-ext-diff",
      "new": "--text --no-ext-diff"
    },
    {
      "name": "merge commits' own changes not scanned (no -m)",
      "old": "--log-opts=\"--all -m --text",
      "new": "--log-opts=\"--all --text"
    },
    {
      "name": "only the config GITLEAKS_ variables stripped",
      "old": "while IFS= read -r v; do unset \"$v\"; done < <(compgen -e | grep '^GITLEAKS_' || true)",
      "new": "unset GITLEAKS_CONFIG GITLEAKS_CONFIG_TOML"
    }
  ]
}
