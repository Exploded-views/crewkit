{
  "target": "plugins/crew-lanes/bin/lane-land",
  "suite": [
    "bats",
    "--abort",
    "tests/lane-land.bats"
  ],
  "mutants": [
    {
      "name": "merge pause ignored",
      "old": "if [[ $paused == true ]]; then",
      "new": "if false; then"
    },
    {
      "name": "draft or closed accepted",
      "old": "[[ $(field .state) == OPEN && $(field .isDraft) == false ]] || say",
      "new": "true || say"
    },
    {
      "name": "stale lane head accepted",
      "old": "if [[ -n $lane_head && $lane_head != null && $lane_head != \"$head\" ]]; then",
      "new": "if false; then"
    },
    {
      "name": "dirty accepted",
      "old": "[[ $(field .mergeStateStatus) != DIRTY ]] || say",
      "new": "true || say"
    },
    {
      "name": "owner gate off",
      "old": "  [[ -z $why ]] || say \"NEEDS-OWNER-PRESENT",
      "new": "  true || say \"NEEDS-OWNER-PRESENT"
    },
    {
      "name": "unconfirmed risk areas allowed",
      "old": "  [[ -n $(crew_setting high_risk_areas.confirmed_by \"\") ]] || why=",
      "new": "  true || why="
    },
    {
      "name": "gated lanes ignored",
      "old": "  jq -e --arg l \"$lane\" 'index($l) != null' <<<\"$(get ownerGatedLanes)\" >/dev/null && why=",
      "new": "  false && why="
    },
    {
      "name": "empty exemption read counts as exempt",
      "old": "if [[ -z ${exempt//[[:space:]]/} ]] || ! child jq -e 'type == \"array\"'",
      "new": "if ! child jq -e 'type == \"array\"'"
    },
    {
      "name": "non-list exemption accepted",
      "old": " || ! child jq -e 'type == \"array\"' <<<\"$exempt\" >/dev/null 2>&1; then",
      "new": "; then"
    },
    {
      "name": "failed mergePaused read counts as not paused",
      "old": "  || say \"STATE-UNREADABLE (can't read mergePaused",
      "new": "  || true; : \"(can't read mergePaused"
    },
    {
      "name": "a failed exemption read keeps what it printed",
      "old": "mergePauseExempt 2>/dev/null) || exempt=\"\"",
      "new": "mergePauseExempt 2>/dev/null) || true"
    }
  ]
}
