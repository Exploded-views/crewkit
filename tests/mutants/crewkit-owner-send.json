{
  "target": "libexec/crewkit-owner-send",
  "suite": [
    "bats",
    "--abort",
    "tests/crewkit-owner-send.bats"
  ],
  "mutants": [
    {
      "name": "level map ignored: passive",
      "old": "passive) ylevel=$(setting_word owner_send.levels.passive fyi) ;;",
      "new": "passive) ylevel=fyi ;;"
    },
    {
      "name": "level map ignored: active",
      "old": "active) ylevel=$(setting_word owner_send.levels.active ask) ;;",
      "new": "active) ylevel=ask ;;"
    },
    {
      "name": "level map ignored: time-sensitive",
      "old": "*) ylevel=$(setting_word owner_send.levels.time_sensitive urgent) ;;",
      "new": "*) ylevel=urgent ;;"
    },
    {
      "name": "level map ignored: ntfy",
      "old": "ylevel=$(setting_word owner_send.levels.ntfy wake)",
      "new": "ylevel=wake"
    },
    {
      "name": "level map: active sent as passive",
      "old": "active) ylevel=$(setting_word owner_send.levels.active ask) ;;",
      "new": "active) ylevel=$(setting_word owner_send.levels.passive fyi) ;;"
    },
    {
      "name": "read channel setting ignored: bark",
      "old": "read_channel=$(setting_word owner_send.channels.bark iphone)",
      "new": "read_channel=iphone"
    },
    {
      "name": "read channel setting ignored: ntfy",
      "old": "read_channel=$(setting_word owner_send.channels.ntfy phone)",
      "new": "read_channel=phone"
    },
    {
      "name": "ntfy form reads the bark channel",
      "old": "read_channel=$(setting_word owner_send.channels.ntfy phone)",
      "new": "read_channel=$(setting_word owner_send.channels.bark iphone)"
    },
    {
      "name": "journal counted",
      "old": "select(.channel == $c)",
      "new": "select(.channel == $c or .channel == \"journal\")"
    },
    {
      "name": "any channel counted",
      "old": "select(.channel == $c)",
      "new": "select(true)"
    },
    {
      "name": "unconfirmed treated as sent",
      "old": "if $x.unconfirmed == true then \" unconfirmed\" else \"\" end",
      "new": "if false then \" unconfirmed\" else \"\" end"
    },
    {
      "name": "note sent on the ntfy form",
      "old": "form=ntfy\nif ((have_rule || have_level || have_note)); then\n  ((have_rule && have_level)) || usage   # a bark form carries a rule and a level\n  form=bark\nfi",
      "new": "form=ntfy\nif ((have_rule && have_level)); then\n  form=bark\nfi"
    },
    {
      "name": "refused config printed for exit 69",
      "old": "*) echo \"failed -\" ;;",
      "new": "*) echo \"refused config\" ;;"
    },
    {
      "name": "exit 69 printed as unknown",
      "old": "*) echo \"failed -\" ;;",
      "new": "*) echo \"unknown -\" ;;"
    },
    {
      "name": "exit 0 sent printed as unknown",
      "old": "sent) echo \"sent -\" ;;",
      "new": "sent) echo \"unknown -\" ;;"
    },
    {
      "name": "a refusal's control characters kept",
      "old": "tr -d '[:cntrl:]'",
      "new": "cat"
    },
    {
      "name": "rule not checked",
      "old": "[[ $rule =~ ^[a-z][a-z-]{0,29}$ ]]",
      "new": "true"
    },
    {
      "name": "rule length 31",
      "old": "^[a-z][a-z-]{0,29}$",
      "new": "^[a-z][a-z-]{0,30}$"
    },
    {
      "name": "rule digits allowed",
      "old": "^[a-z][a-z-]{0,29}$",
      "new": "^[a-z][a-z0-9-]{0,29}$"
    },
    {
      "name": "level not checked",
      "old": "[[ $level == passive || $level == active || $level == time-sensitive ]] ||",
      "new": "true ||"
    },
    {
      "name": "empty note allowed",
      "old": "[[ -n $wnote ]] || ck_die 65 \"the note is empty\"",
      "new": "true"
    },
    {
      "name": "note limit 201",
      "old": "((${#wnote} <= 200))",
      "new": "((${#wnote} <= 201))"
    },
    {
      "name": "note limit 199",
      "old": "((${#wnote} <= 200))",
      "new": "((${#wnote} <= 199))"
    },
    {
      "name": "note control character allowed",
      "old": "[[ ! $wnote =~ [[:cntrl:]] ]]",
      "new": "true"
    },
    {
      "name": "duplicate entry allowed",
      "old": "--notify-entry) (($# >= 2)) || usage; ((have_entry == 0)) || usage;",
      "new": "--notify-entry) (($# >= 2)) || usage;"
    },
    {
      "name": "duplicate rule allowed",
      "old": "--rule) (($# >= 2)) || usage; ((have_rule == 0)) || usage;",
      "new": "--rule) (($# >= 2)) || usage;"
    },
    {
      "name": "duplicate level allowed",
      "old": "--level) (($# >= 2)) || usage; ((have_level == 0)) || usage;",
      "new": "--level) (($# >= 2)) || usage;"
    },
    {
      "name": "duplicate note allowed",
      "old": "--note) (($# >= 2)) || usage; ((have_note == 0)) || usage;",
      "new": "--note) (($# >= 2)) || usage;"
    },
    {
      "name": "bark form without a level allowed",
      "old": "((have_rule && have_level)) || usage",
      "new": "true"
    },
    {
      "name": "entry not required",
      "old": "((have_entry)) || usage",
      "new": "true"
    },
    {
      "name": "--json dropped from the call",
      "old": "dedup-key \"$dedup_key\" --json)",
      "new": "dedup-key \"$dedup_key\")"
    },
    {
      "name": "stdin left open for yo-human",
      "old": "\"${args[@]}\" < /dev/null)",
      "new": "\"${args[@]}\")"
    },
    {
      "name": "a bad level setting accepted",
      "old": "word_ok \"$v\" || ck_die 78",
      "new": "true || ck_die 78"
    },
    {
      "name": "a relative binary path accepted",
      "old": "[[ $yh =~ ^/[^[:cntrl:]]+$ || $yh =~ ^[A-Za-z0-9][A-Za-z0-9._+-]*$ ]]",
      "new": "true"
    },
    {
      "name": "ask dropped from the Bark form",
      "old": "if [[ $form == bark ]]; then args+=(--ask \"$ask\"); fi",
      "new": "true"
    },
    {
      "name": "ask also sent on the ntfy form",
      "old": "if [[ $form == bark ]]; then args+=(--ask \"$ask\"); fi",
      "new": "args+=(--ask \"Open $id@$rev on the board\")"
    },
    {
      "name": "ask setting ignored",
      "old": "ask=$(crew_setting owner_send.ask 'Open <id>@<rev> on the board')",
      "new": "ask='Open <id>@<rev> on the board'"
    },
    {
      "name": "ask length limit 201",
      "old": "((${#ask} <= 200))",
      "new": "((${#ask} <= 201))"
    },
    {
      "name": "other placeholders allowed in the ask",
      "old": " && ! $ask =~ \\<[^\\<\\>]*\\> ]]",
      "new": " ]]"
    },
    {
      "name": "empty ask allowed",
      "old": "[[ -n $ask ]] || ck_die 78 \"owner_send.ask is empty\"",
      "new": "true"
    },
    {
      "name": "nonce dropped from the dedup key",
      "old": "dedup_key=${ref/@/-}-$nonce",
      "new": "dedup_key=${ref/@/-}"
    },
    {
      "name": "revision dropped from the dedup key",
      "old": "dedup_key=${ref/@/-}-$nonce",
      "new": "dedup_key=${ref%@*}-$nonce"
    },
    {
      "name": "rule sent on the ntfy form",
      "old": "  title=\"$ref\"\nfi",
      "new": "  title=\"$ref $rule\"\nfi"
    },
    {
      "name": "rule dropped from the bark title",
      "old": "title=\"$ref $rule\"",
      "new": "title=\"$ref\""
    },
    {
      "name": "ask placeholder not filled in",
      "old": "ask=${ask//'<id>@<rev>'/$ref}",
      "new": "true"
    },
    {
      "name": "exit 75 printed as failed",
      "old": "((rc != 75)) || ambiguous \"queued, yo-human retries it\"",
      "new": "((rc != 75)) || { echo \"failed -\"; exit 0; }"
    },
    {
      "name": "ambiguous mapped to failed",
      "old": "  echo \"unknown -\"\n  exit 0\n}",
      "new": "  echo \"failed -\"\n  exit 0\n}"
    },
    {
      "name": "unexpected exit code mapped to failed",
      "old": "*) ambiguous \"unexpected exit code\" ;; esac",
      "new": "*) echo \"failed -\"; exit 0 ;; esac"
    },
    {
      "name": "unexpected exit code answered from the JSON",
      "old": "case $rc in 0 | 69 | 75) ;; *) ambiguous \"unexpected exit code\" ;; esac",
      "new": "true"
    },
    {
      "name": "exit 0 other status printed as sent",
      "old": "      *) echo \"unknown -\" ;;\n    esac ;;\n  69)",
      "new": "      *) echo \"sent -\" ;;\n    esac ;;\n  69)"
    },
    {
      "name": "exit 0 with the channel absent answered",
      "old": "absent) ambiguous \"channel $read_channel is not in the result\" ;;",
      "new": "absent) echo \"sent -\" ;;"
    },
    {
      "name": "exit 0 with the channel absent mapped to failed",
      "old": "absent) ambiguous \"channel $read_channel is not in the result\" ;;",
      "new": "absent) echo \"failed -\" ;;"
    },
    {
      "name": "exit 69 with sent answered",
      "old": "sent | \"sent unconfirmed\") ambiguous \"exit 69 but channel $read_channel says sent\" ;;",
      "new": "sent | \"sent unconfirmed\") echo \"sent -\" ;;"
    },
    {
      "name": "missing binary exits 70",
      "old": "[[ -f $yh && -x $yh ]] || refuse_binary\n",
      "new": "[[ -f $yh && -x $yh ]] || exit 70\n"
    },
    {
      "name": "missing binary answered unknown",
      "old": "  echo \"refused config\"\n  exit 0\n}\nif [[ $yh == /*",
      "new": "  echo \"unknown -\"\n  exit 0\n}\nif [[ $yh == /*"
    },
    {
      "name": "entry validation skipped",
      "old": "[[ $1 =~ $re ]] || return 1",
      "new": "true"
    },
    {
      "name": "entry regex loosened",
      "old": "local LC_ALL=C re=\"^${ref_re}:([0-9a-f]{16})\\$\"",
      "new": "local LC_ALL=C re='^(.*):([0-9a-f]{16})$'"
    },
    {
      "name": "id narrowed back to the old regex",
      "old": "ref_re=\"(${ref_id}@[0-9]{1,4}\"",
      "new": "ref_re=\"([a-z][a-z0-9]{0,15}-[0-9]{1,9}@[0-9]{1,6}\""
    },
    {
      "name": "ruling ids dropped",
      "old": "|ruling-[0-9]{8}-[0-9]{1,4}",
      "new": ""
    },
    {
      "name": "id prefix 9 letters",
      "old": "([a-z]{1,8}-[0-9]{1,6}",
      "new": "([a-z]{1,9}-[0-9]{1,6}"
    },
    {
      "name": "revision 5 digits",
      "old": "@[0-9]{1,4}\"",
      "new": "@[0-9]{1,5}\""
    },
    {
      "name": "digest ids dropped",
      "old": "|digest-${ref_stamp}@1",
      "new": ""
    },
    {
      "name": "hub-blind ids dropped",
      "old": "|hub-blind-${ref_name}-${ref_stamp}@1",
      "new": ""
    },
    {
      "name": "bark-fail ids dropped",
      "old": "|bark-fail-${ref_stamp_s}@1",
      "new": ""
    },
    {
      "name": "bridge ids dropped",
      "old": "|bridge-${ref_stamp}@1",
      "new": ""
    },
    {
      "name": "baseline ids dropped",
      "old": "|baseline-${ref_stamp}@1",
      "new": ""
    },
    {
      "name": "herdr ids dropped",
      "old": "|herdr-${ref_stamp}@1",
      "new": ""
    },
    {
      "name": "wall ids dropped",
      "old": "|wall-${ref_stamp}@1",
      "new": ""
    },
    {
      "name": "bark-orphan ids dropped",
      "old": "|bark-orphan-${ref_stamp_s}@1)",
      "new": ")"
    },
    {
      "name": "seconds stamps dropped",
      "old": "ref_stamp_s='[0-9]{8}T[0-9]{4}([0-9]{2})?Z'",
      "new": "ref_stamp_s='[0-9]{8}T[0-9]{4}Z'"
    },
    {
      "name": "synthetic rev not pinned to 1",
      "old": "|digest-${ref_stamp}@1",
      "new": "|digest-${ref_stamp}@[0-9]"
    },
    {
      "name": "entry nonce 15 digits allowed",
      "old": "([0-9a-f]{16})\\$\"",
      "new": "([0-9a-f]{15,16})\\$\""
    },
    {
      "name": "entry nonce uppercase allowed",
      "old": "([0-9a-f]{16})\\$\"",
      "new": "([0-9a-fA-F]{16})\\$\""
    },
    {
      "name": "error.what not read",
      "old": ".error.what? // ",
      "new": ""
    },
    {
      "name": "errors[0] not read",
      "old": " // ((.errors // [])[0]? | .what?)",
      "new": ""
    },
    {
      "name": "a plain string error not read",
      "old": " // (.error | strings)",
      "new": ""
    },
    {
      "name": "jq missing answered",
      "old": "type -P jq > /dev/null 2>&1 || no_answer \"jq is required\"",
      "new": "true"
    },
    {
      "name": "78 mapped to refused config",
      "old": "if [[ $state == sent ]]; then echo \"sent - config\"; else echo \"unknown - config\"; fi",
      "new": "echo \"refused config\""
    },
    {
      "name": "78 sent mapped to unknown",
      "old": "if [[ $state == sent ]]; then echo \"sent - config\"; else echo \"unknown - config\"; fi",
      "new": "echo \"unknown - config\""
    },
    {
      "name": "config tag dropped",
      "old": "if [[ $state == sent ]]; then echo \"sent - config\"; else echo \"unknown - config\"; fi",
      "new": "if [[ $state == sent ]]; then echo \"sent -\"; else echo \"unknown -\"; fi"
    },
    {
      "name": "78 unconfirmed or other mapped to sent",
      "old": "if [[ $state == sent ]]; then echo \"sent - config\"; else echo \"unknown - config\"; fi",
      "new": "echo \"sent - config\""
    },
    {
      "name": "78 treated as 64",
      "old": "if ((rc == 64)); then\n  msg=$(error_text)",
      "new": "if ((rc == 64 || rc == 78)); then\n  msg=$(error_text)"
    },
    {
      "name": "78 channel state ignored: unparseable counted sent",
      "old": "state=$(channel_state) || state=''",
      "new": "state=$(channel_state) || state=sent"
    },
    {
      "name": "78 error text not written to stderr",
      "old": "note \"yo-human reported a config problem (exit 78): ${msg:-no error text}\"",
      "new": "true"
    },
    {
      "name": "a 64 refusal's error not written to stderr",
      "old": "note \"yo-human refused the call (exit 64): ${msg:-no error text}\"",
      "new": "true"
    },
    {
      "name": "unparseable JSON mapped to failed",
      "old": "state=$(channel_state) || ambiguous \"no usable JSON\"",
      "new": "state=$(channel_state) || { echo \"failed -\"; exit 0; }"
    },
    {
      "name": "unparseable JSON answered as sent",
      "old": "state=$(channel_state) || ambiguous \"no usable JSON\"",
      "new": "state=$(channel_state) || state=sent"
    },
    {
      "name": "prefix not stripped",
      "old": "  printf '%s\\n' \"${s#state=}\"",
      "new": "  printf '%s\\n' \"$s\""
    },
    {
      "name": "prefix check dropped",
      "old": "  [[ $s == state=* && $s != *$'\\n'* ]] || return 1\n",
      "new": "  [[ $s != *$'\\n'* ]] || return 1\n"
    },
    {
      "name": "second JSON value accepted",
      "old": "  [[ $s == state=* && $s != *$'\\n'* ]] || return 1\n",
      "new": "  [[ $s == state=* ]] || return 1\n"
    },
    {
      "name": "jq exit status ignored",
      "old": "<<< \"$out\" 2> /dev/null) || return 1\n",
      "new": "<<< \"$out\" 2> /dev/null)\n"
    },
    {
      "name": "PATH binary refusal dropped",
      "old": "    refuse_binary \"not on PATH\"\n",
      "new": "    :\n"
    },
    {
      "name": "PATH lookup failure ignored",
      "old": "if ! yh_bin=$(type -P \"$yh\" 2> /dev/null) || ",
      "new": "if false || "
    }
  ]
}
