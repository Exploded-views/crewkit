{
  "target": "tests/stub-reaper.bash",
  "suite": [
    "bats",
    "--abort",
    "tests/stub-reaper.bats"
  ],
  "mutants": [
    {
      "name": "a live run's stub is stopped",
      "old": "    if kill -0 \"$owner\" 2> /dev/null; then",
      "new": "    if false; then"
    },
    {
      "name": "the start time is not compared",
      "old": "    [[ -n $now && $now == \"$start\" ]] && kill -9 \"$pid\" 2> /dev/null",
      "new": "    [[ -n $now ]] && kill -9 \"$pid\" 2> /dev/null"
    },
    {
      "name": "the stub is not stopped",
      "old": "kill -9 \"$pid\" 2> /dev/null\n  done",
      "new": "kill -0 \"$pid\" 2> /dev/null\n  done"
    },
    {
      "name": "a live run's entry is dropped",
      "old": "      printf '%s %s %s\\n' \"$pid\" \"$owner\" \"$start\" >> \"$keep\"\n",
      "new": "      :\n"
    },
    {
      "name": "the registry is not rewritten",
      "old": "  mv \"$keep\" \"$file\"",
      "new": "  rm -f \"$keep\""
    },
    {
      "name": "the start time keeps its spaces",
      "old": "  s=${s//[[:space:]]/_}\n",
      "new": ""
    },
    {
      "name": "a stub registers its parent",
      "old": "printf '%s %s %s\\n' \"$$\" \"$2\" \"$(_stub_start \"$$\")\"",
      "new": "printf '%s %s %s\\n' \"$PPID\" \"$2\" \"$(_stub_start \"$$\")\""
    },
    {
      "name": "a missing registry is not skipped",
      "old": "  [[ -f $file && ! -L $file && -O $file ]] || return 0\n",
      "new": ""
    },
    {
      "name": "the owner is not recorded",
      "old": "printf '%s %s %s\\n' \"$$\" \"$2\" \"$(_stub_start \"$$\")\"",
      "new": "printf '%s %s %s\\n' \"$$\" \"$$\" \"$(_stub_start \"$$\")\""
    },
    {
      "name": "stub_exec does not register",
      "old": "  stub_register \"$file\" \"$owner\"\n  exec \"$@\"",
      "new": "  exec \"$@\""
    },
    {
      "name": "stub_exec runs the command as a child",
      "old": "  exec \"$@\"\n}",
      "new": "  \"$@\"\n}"
    },
    {
      "name": "a registry that is a link is read",
      "old": "[[ -f $file && ! -L $file && -O $file ]]",
      "new": "[[ -f $file && -O $file ]]"
    },
    {
      "name": "an owner of 0 or 1 is taken for a dead run",
      "old": "((pid > 1 && owner > 1))",
      "new": "((pid > 1))"
    },
    {
      "name": "a stub registers through a link",
      "old": "[[ ! -L $1 ]] && { [[ ! -e $1 ]] || [[ -O $1 ]]; } || return 0",
      "new": "{ [[ ! -e $1 ]] || [[ -O $1 ]]; } || return 0"
    }
  ]
}
