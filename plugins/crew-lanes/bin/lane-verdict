#!/usr/bin/env python3
"""lane-verdict: write and check independent review verdict records.

  lane-verdict record PR HEAD_SHA merge|changes --reviewer WHO --implementer WHO --model MODEL
  lane-verdict check PR HEAD_SHA --implementer WHO [--model MODEL]

Records live in <review.verdict_dir>/<pr>/: round 1 is <headSha>.json and each later round
<headSha>.<round>.json, never overwritten, each written through a temp file and a rename. The
format and the acceptance rules are in crewkit's docs/review-verdicts.md.

check asks the shared lib/verdict.py (the same rules every crewkit lander uses; see
docs/review-verdicts.md), passing --implementer as the lane's implementer, --model as the
model the deciding records must name (default: the review_model setting, itself opus by
default; --model "" or an empty review_model: no model check), and the review.reviewers and
review.verdict_dir settings.

Exit (docs/exit-codes.md): record 0 = written; check 0 = accepted, 1 = not accepted (the
reason is printed); 64 = usage; 65 = a refused record (a self-review, a short SHA, an unknown
verdict).
"""
import datetime
import json
import os
import pathlib
import re
import subprocess
import sys
import tempfile

HERE = pathlib.Path(__file__).resolve().parent
SHA = re.compile(r"^[0-9a-f]{40}$")


def setting(key, default):
    # Key and default go in as arguments, never as shell text: a value can hold quotes or $(...).
    # Settings come from the main checkout, never a lane's worktree (crew_cd_main_checkout).
    out = subprocess.run(["bash", "-c", f'source "$1" && {{ crew_cd_main_checkout || exit 78; }} && crew_setting "$2" "$3"', "bash",  # settings-keys: review.verdict_dir state_dir review.reviewers review_model
                          str(HERE.parent / "lib" / "settings.sh"), key, default], capture_output=True, text=True)
    if out.returncode == 78:
        print("lane-verdict: can't find this repository's main checkout to read settings from", file=sys.stderr)
        sys.exit(78)
    return out.stdout.rstrip("\n") if out.returncode == 0 else default


def verdict_dir():
    state = os.path.expanduser(setting("state_dir", "~/.local/state/crewkit"))
    return pathlib.Path(os.path.expanduser(setting("review.verdict_dir", os.path.join(state, "verdicts"))))


def opts(args, names):
    found, rest, i = {}, [], 0
    while i < len(args):
        if args[i].startswith("--") and args[i][2:] in names and i + 1 < len(args):
            found[args[i][2:]] = args[i + 1]
            i += 2
        else:
            rest.append(args[i])
            i += 1
    return found, rest


def records(pr, head):
    """[(round, body or None)] for the head, from every <head>[.<round>].json file."""
    out = []
    d = verdict_dir() / str(pr)
    for f in sorted(d.glob(f"{head}*.json")) if d.is_dir() else []:
        m = re.fullmatch(re.escape(head) + r"(?:\.(\d+))?\.json", f.name)
        if not m:
            continue
        rnd = int(m.group(1) or 1)
        try:
            out.append((rnd, json.loads(f.read_text())))
        except (OSError, ValueError):
            out.append((rnd, None))
    return sorted(out, key=lambda r: r[0])


def check(pr, head, implementer, model=""):
    """The shared rules in lib/verdict.py decide; this passes it the settings."""
    out = subprocess.run([sys.executable, str(HERE.parent / "lib" / "verdict.py"), "records",
                          "--pr", str(pr), "--head", head, "--dir", str(verdict_dir()),
                          "--lane-implementer", implementer, "--reviewers", setting("review.reviewers", ""),
                          "--model", model],
                         capture_output=True, text=True)
    if out.returncode == 0:
        return None
    msg = out.stdout.strip() or out.stderr.strip()
    return msg[len("not accepted: "):] if msg.startswith("not accepted: ") else msg


def record(pr, head, verdict, reviewer, implementer, model):
    if not SHA.match(head):
        return f"head {head!r} is not a full 40-hex SHA"
    if verdict not in ("merge", "changes"):
        return f"verdict must be merge or changes, not {verdict!r}"
    if not reviewer or reviewer == implementer:
        return "the reviewer must be named and must not be the implementer"
    d = verdict_dir() / str(pr)
    d.mkdir(parents=True, exist_ok=True)
    rnd = (records(pr, head)[-1][0] + 1) if records(pr, head) else 1
    name = f"{head}.json" if rnd == 1 else f"{head}.{rnd}.json"
    body = {"schema": 1, "pr": int(pr) if str(pr).isdigit() else pr, "headSha": head, "verdict": verdict,
            "round": rnd, "reviewer": reviewer, "implementer": implementer, "model": model,
            "reviewedAt": datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")}
    fd, tmp = tempfile.mkstemp(dir=d, prefix=".verdict.", suffix=".tmp")
    with os.fdopen(fd, "w") as f:
        json.dump(body, f, indent=2)
        f.write("\n")
    os.replace(tmp, d / name)
    print(d / name)
    return None


def main(argv):
    if not argv or argv[0] not in ("record", "check"):
        print(__doc__.strip(), file=sys.stderr)
        return 64
    cmd = argv[0]
    o, rest = opts(argv[1:], {"reviewer", "implementer", "model"})
    if cmd == "record":
        if len(rest) != 3 or not {"reviewer", "implementer", "model"} <= set(o):
            print(__doc__.strip(), file=sys.stderr)
            return 64
        why = record(rest[0], rest[1], rest[2], o["reviewer"], o["implementer"], o["model"])
        if why:
            print(f"lane-verdict: refused: {why}", file=sys.stderr)
            return 65
        return 0
    if len(rest) != 2 or "implementer" not in o:
        print("lane-verdict: check needs PR, HEAD_SHA and --implementer (so a self-review is caught)", file=sys.stderr)
        return 64
    # review_model is file-only (lib/settings.sh CREW_FILE_ONLY), like every gate setting.
    model = o["model"] if "model" in o else setting("review_model", "opus")
    why = check(rest[0], rest[1], o["implementer"], model)
    if why:
        print(f"not accepted: {why}")
        return 1
    print("accepted")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
