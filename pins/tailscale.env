# Pinned tailscale release used by the registry holder image (holder/Dockerfile), not by install.sh.
# Assets: <URL>/tailscale_<version>_<amd64|arm64>.tgz (Linux only; the holder is a Linux image).
# pkgs.tailscale.com publishes a .sha256 beside each file; the values below agree with it. Pin a
# hash only after downloading the published tarball and hashing it yourself.
TAILSCALE_URL=https://pkgs.tailscale.com/stable
TAILSCALE_TAG=v1.104.4
TAILSCALE_SHA256_linux_amd64=624ea093d47d62cf56f17b8332d74b8decda4a1faa610ebc60a1de334b2b3dc9
TAILSCALE_SHA256_linux_arm64=a1c249ce6bdebef62e1ae3b997595555bce2ae4709bf95a718e9ca7a129dad7e
