# Pinned herdr release used by install.sh: the Exploded-views fork.
# Assets: herdr-<tag>-<triple>.tar.gz, each holding one plain file `herdr`, plus
# herdr-<tag>-<triple>.tar.gz.sha256 (one shasum-format line: <sha256>  <asset name>). Triples:
# x86_64-unknown-linux-musl, aarch64-unknown-linux-musl, x86_64-apple-darwin, aarch64-apple-darwin.
# Pin a hash only after downloading the tarball and hashing it yourself; install.sh also checks
# the release's .sha256 file against the pin.
# HERDR_VERSION (optional) is the version the binary prints as `herdr <version>`. The fork's
# binary still reports its base version (0.9.5), not the tag, and upstream prints the same
# line, so until the fork fixes that (fork issue 20) the pinned tarball sha256 is the real
# identity check, not the version line. Drop HERDR_VERSION with the first pin after the fix;
# install.sh then wants `herdr <tag without v>`.
HERDR_URL=https://github.com/Exploded-views/herdr/releases/download
HERDR_TAG=v0.9.5-ev.2
HERDR_VERSION=0.9.5
HERDR_SHA256_linux_amd64=bb688ad48a17c8624a88450df827c2b9a18c40584b391367ba947db00c954352
HERDR_SHA256_linux_arm64=cd0900e1ec48cf7fd3a3c88bdeeb1f91dbdd2ade395e018e854a73660652d485
HERDR_SHA256_darwin_amd64=690cb0b665f64099f9d95d388e00f57359d899b93ddd1e3aa7f1bac2680acbeb
HERDR_SHA256_darwin_arm64=6b5fa3733fbc4ed38b372a607c9e67c8fadeab9ea0523dba25d891d080086a5d
